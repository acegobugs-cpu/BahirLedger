{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: verify",
      "type": "shell",
      "command": "./mvnw",
      "args": ["verify"],
      "windows": { "command": ".\\mvnw.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Backend: run",
      "type": "shell",
      "command": "./mvnw",
      "args": ["spring-boot:run"],
      "windows": { "command": ".\\mvnw.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}